PUT http://localhost:8080/api/suppliers/103
Content-Type: application/json

{
  "name": "Päivitetty Tukku Oy",
  "contactName": "Matti Myyjä",
  "phone": "040-9999999",
  "email": "uusi@testitukku.fi"
}

